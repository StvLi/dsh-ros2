  "cards": [
    {
      "dot": "emerald",
      "title": "转接核心：缝隙 + 契约",
      "items": [
        "ToolDeps 注入 run/approval/jobs/gui/vision，测试全用 fake",
        "跨包用 ROS2 服务契约：/vlm/describe、/safety/state、/move_action",
        "JSON 为桥接唯一数据格式（无 ROS2 类型泄漏入 Harness）"
      ]
    },
    {
      "dot": "cyan",
      "title": "两条执行模式",
      "items": [
        "L1/L2 诊断：ros2 CLI（经 daemon）· 一次工具 = 一次子进程",
        "重活（安全/视觉/运动）：常驻 ROS2 节点/服务，桥接只触发或订阅"
      ]
    },
    {
      "dot": "rose",
      "title": "效率观察点",
      "items": [
        "有 rosSetup 时每调用走一次 bash -lc 包装（≈ +20-60ms）",
        "L1 一次工具含 daemon 往返（数百 ms），agent 节奏下可接受",
        "moveit_move 单路径约 5-6 次子进程 + 探测，可合并为常驻流程"
      ]
    }
  ]
