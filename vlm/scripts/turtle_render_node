#!/usr/bin/env python3
"""Headless renderer for the turtlesim demo (dsh-ros2).

Subscribes /turtle1/pose and publishes a rendered image topic
(/turtle1/render, sensor_msgs/Image rgb8) drawn with OpenCV — no X11, no
window manager. This mirrors how a real headless robot exposes its camera /
simulation-render topics: agents read image *topics*, never screenshots.
"""

import math
import os

import cv2
import numpy as np
import rclpy
from rclpy.node import Node

from turtlesim.msg import Pose as TurtlePose
from sensor_msgs.msg import Image

CANVAS = 500          # px
WORLD = 11.111111     # turtlesim world size
SCALE = CANVAS / WORLD
BG = (69, 86, 255)    # turtlesim default background (BGR)
TRAIL = (255, 255, 255)
SHELL = (46, 200, 90)  # green shell (BGR)
HEAD = (20, 20, 20)


class TurtleRenderNode(Node):
    def __init__(self):
        super().__init__("turtle_render_node")
        self._pose = None
        self._trail: list[tuple[float, float]] = []
        self.create_subscription(TurtlePose, "/turtle1/pose", self._on_pose, 10)
        self._pub = self.create_publisher(Image, "/turtle1/render", 10)
        self.create_timer(0.1, self._publish_frame)  # 10 Hz
        self.get_logger().info("turtle_render_node ready: /turtle1/pose -> /turtle1/render (10 Hz)")

    def _on_pose(self, msg: TurtlePose):
        self._pose = msg
        x = msg.x * SCALE
        y = (WORLD - msg.y) * SCALE  # world y points up; image y points down
        if not self._trail or (abs(self._trail[-1][0] - x) > 1.0 or abs(self._trail[-1][1] - y) > 1.0):
            self._trail.append((x, y))
            if len(self._trail) > 8000:
                del self._trail[:1000]

    def _publish_frame(self):
        canvas = np.full((CANVAS, CANVAS, 3), BG, np.uint8)
        if len(self._trail) >= 2:
            pts = np.asarray(self._trail, np.int32).reshape(-1, 1, 2)
            cv2.polylines(canvas, [pts], False, TRAIL, 2, cv2.LINE_AA)
        if self._pose is not None:
            cx = int(self._pose.x * SCALE)
            cy = int((WORLD - self._pose.y) * SCALE)
            cv2.circle(canvas, (cx, cy), 18, SHELL, -1, cv2.LINE_AA)
            # heading arrow: image y is flipped, so negate theta
            ang = -self._pose.theta
            tip = (int(cx + 34 * math.cos(ang)), int(cy + 34 * math.sin(ang)))
            cv2.line(canvas, (cx, cy), tip, HEAD, 4, cv2.LINE_AA)
            cv2.circle(canvas, tip, 4, HEAD, -1, cv2.LINE_AA)
        rgb = cv2.cvtColor(canvas, cv2.COLOR_BGR2RGB)
        msg = Image()
        msg.header.stamp = self.get_clock().now().to_msg()
        msg.header.frame_id = "turtle_render"
        msg.height = CANVAS
        msg.width = CANVAS
        msg.encoding = "rgb8"
        msg.is_bigendian = 0
        msg.step = CANVAS * 3
        msg.data = rgb.tobytes()
        self._pub.publish(msg)


def _ensure_ros_log_dir() -> None:
    """rclpy aborts when ~/.ros/log is not writable; fall back to a writable dir."""
    if os.environ.get("ROS_LOG_DIR"):
        return
    target = os.path.expanduser("~/.ros/log")
    try:
        os.makedirs(target, exist_ok=True)
        probe = os.path.join(target, ".dsh-vlm-probe")
        with open(probe, "w", encoding="utf-8"):
            pass
        os.remove(probe)
    except OSError:
        fallback = f"/tmp/ros-log-{os.getuid()}"
        os.makedirs(fallback, exist_ok=True)
        os.environ["ROS_LOG_DIR"] = fallback


def main():
    _ensure_ros_log_dir()
    rclpy.init()
    node = TurtleRenderNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    main()
