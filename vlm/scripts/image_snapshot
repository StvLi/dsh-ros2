#!/usr/bin/env python3
"""Take the latest frame from a sensor_msgs/Image topic and save it as JPEG.

Headless image acquisition for dsh-ros2: agents read image *topics*, never
X11 screenshots. Usage:

    ros2 run dsh_ros2_vlm image_snapshot --ros-args \
        -p topic:=/turtle1/render -p output:=/tmp/frame.jpg -p timeout_ms:=5000

Prints a JSON line on success/failure for easy tool parsing.
"""

import json
import os
import sys

import cv2
import numpy as np
import rclpy
from rclpy.node import Node

from sensor_msgs.msg import Image


class ImageSnapshot(Node):
    def __init__(self):
        super().__init__("image_snapshot")
        self.declare_parameter("topic", "/turtle1/render")
        self.declare_parameter("output", "")
        self.declare_parameter("timeout_ms", 5000)
        self._topic = str(self.get_parameter("topic").value)
        self._output = str(self.get_parameter("output").value)
        self._timeout_ms = int(self.get_parameter("timeout_ms").value)
        if not self._output:
            self._output = f"/tmp/dsh-ros2/snapshot_{int(self.get_clock().now().nanoseconds / 1_000_000)}.jpg"
        os.makedirs(os.path.dirname(self._output) or ".", exist_ok=True)
        self._latest = None
        self.create_subscription(Image, self._topic, self._cb, 1)
        self.get_logger().info(f"image_snapshot: subscribing {self._topic} (timeout {self._timeout_ms}ms)")

    def _cb(self, msg: Image):
        if msg.encoding == "rgb8":
            frame = cv2.cvtColor(np.frombuffer(bytes(msg.data), np.uint8).reshape(msg.height, msg.width, 3), cv2.COLOR_RGB2BGR)
        elif msg.encoding == "bgr8":
            frame = np.frombuffer(bytes(msg.data), np.uint8).reshape(msg.height, msg.width, 3)
        elif msg.encoding == "mono8":
            frame = np.frombuffer(bytes(msg.data), np.uint8).reshape(msg.height, msg.width)
        else:
            self.get_logger().error(f"unsupported encoding: {msg.encoding}")
            return
        self._latest = frame

    def run(self) -> int:
        deadline = self.get_clock().now().nanoseconds / 1_000_000 + self._timeout_ms
        while (self.get_clock().now().nanoseconds / 1_000_000) < deadline:
            rclpy.spin_once(self, timeout_sec=0.2)
            if self._latest is not None:
                ok, buf = cv2.imencode(".jpg", self._latest, [int(cv2.IMWRITE_JPEG_QUALITY), 90])
                if not ok:
                    print(json.dumps({"ok": False, "error": "JPEG encode failed"}))
                    return 1
                with open(self._output, "wb") as fh:
                    fh.write(buf.tobytes())
                h, w = self._latest.shape[:2]
                print(json.dumps({"ok": True, "path": self._output, "width": int(w), "height": int(h), "bytes": int(len(buf))}))
                return 0
        print(json.dumps({"ok": False, "error": f"no frame on {self._topic} within timeout"}))
        return 1


def main():
    rclpy.init()
    node = ImageSnapshot()
    code = node.run()
    node.destroy_node()
    rclpy.shutdown()
    sys.exit(code)


if __name__ == "__main__":
    main()
