<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dsh_ros2_vlm</name>
  <version>0.1.0</version>
  <description>
    Parallel VLM analysis nodes for dsh-ros2: a ROS2 service (/vlm/describe)
    that runs multimodal vision inference in a separate process, plus a
    headless renderer that publishes turtle pose as an image topic
    (/turtle1/render) so agents never depend on X11 screenshots.
  </description>
  <maintainer email="stvli@users.noreply.github.com">StvLi</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>rosidl_default_runtime</depend>
  <depend>turtlesim</depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
